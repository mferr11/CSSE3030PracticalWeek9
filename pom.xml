<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>csse3030</groupId>
  <artifactId>week9-ekstazi-rts</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <ekstazi.securityManagerArg></ekstazi.securityManagerArg>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Ships a locally-built Ekstazi (see local-maven-repo/README.md for why) so
       the project resolves fully offline-from-Ekstazi's-perspective, with no
       one-time build step required on a fresh clone. -->
  <pluginRepositories>
    <pluginRepository>
      <id>local-ekstazi-build</id>
      <url>file://${project.basedir}/local-maven-repo</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.22.2</version>
        <configuration>
          <!-- Same allowAttachSelf flag as .mvn/jvm.config, applied to the forked test
               JVM too: Ekstazi's javaagent needs it on JDK 11+. The security manager
               flag is injected by the jdk18-plus profile below, only on JDK 17+, since
               it crashes JVM startup on 8/11 (see ekstazi.securityManagerArg above). -->
          <argLine>-Djdk.attach.allowAttachSelf=true ${ekstazi.securityManagerArg}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.ekstazi</groupId>
        <artifactId>ekstazi-maven-plugin</artifactId>
        <!-- Not 5.3.0: the last version published to Maven Central (2018) predates
             Ekstazi's own Java 11/17/21 support commits (unreleased on GitHub as of
             this writing), and silently fails to record most test dependencies under
             Java 17. 5.3.0-jdk17 is built from the current GitHub source and installed
             into the local repo; see README.md "One-time setup". -->
        <version>5.3.0-jdk17</version>
        <executions>
          <execution>
            <id>ekstazi</id>
            <goals>
              <goal>select</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Sets java.security.manager=allow only on JDK 17+, where the value is
         recognized (JEP 411). On 8/11 the string "allow" is instead treated as
         a classname to load as the SecurityManager, and the JVM fails to boot. -->
    <profile>
      <id>jdk17-plus-security-manager</id>
      <activation>
        <jdk>[17,)</jdk>
      </activation>
      <properties>
        <ekstazi.securityManagerArg>-Djava.security.manager=allow</ekstazi.securityManagerArg>
      </properties>
    </profile>
  </profiles>
</project>
