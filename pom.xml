<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>csse3030</groupId>
  <artifactId>week9-ekstazi-rts</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Ships a locally-built Ekstazi (see local-maven-repo/README.md for why) so
       the project resolves fully offline-from-Ekstazi's-perspective, with no
       one-time build step required on a fresh clone. -->
  <pluginRepositories>
    <pluginRepository>
      <id>local-ekstazi-build</id>
      <url>file://${project.basedir}/local-maven-repo</url>
    </pluginRepository>
  </pluginRepositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>2.22.2</version>
        <configuration>
          <!-- Same flags as .mvn/jvm.config, applied to the forked test JVM too:
               Ekstazi's javaagent needs allowAttachSelf on JDK 11+, and JDK 21
               additionally requires re-enabling the (removed-by-default) security
               manager for its instrumentation to work. -->
          <argLine>-Djdk.attach.allowAttachSelf=true -Djava.security.manager=allow</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.ekstazi</groupId>
        <artifactId>ekstazi-maven-plugin</artifactId>
        <!-- Not 5.3.0: the last version published to Maven Central (2018) predates
             Ekstazi's own Java 11/17/21 support commits (unreleased on GitHub as of
             this writing), and silently fails to record most test dependencies under
             Java 17. 5.3.0-jdk17 is built from the current GitHub source and installed
             into the local repo; see README.md "One-time setup". -->
        <version>5.3.0-jdk17</version>
        <executions>
          <execution>
            <id>ekstazi</id>
            <goals>
              <goal>select</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
